# Deployment Mode
DEPLOYMENT_MODE=internal  # or "external"

# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# VAPI Configuration (for transcription)
VAPI_API_KEY=your-vapi-api-key
VAPI_BASE_URL=https://api.vapi.ai

# Retell Configuration (alternative transcription provider)
RETELL_API_KEY=your-retell-api-key
RETELL_BASE_URL=https://api.retell.ai

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Feature Flags
ENABLE_METRICS=true
ENABLE_HEALTH_CHECK=true

# Database
DB_ECHO_SQL=false  # Set to true for debugging

# Redis (for future queue and caching)
REDIS_URL=redis://localhost:6379

# Service URLs (for testing)
BILLING_SERVICE_URL=http://billing-svc:8001
