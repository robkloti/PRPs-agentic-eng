# N8N Configuration (MVP Phase)
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# Cost Controls
MAX_RECORDING_TIME=10000
MAX_DAILY_INTERACTIONS=50
DAILY_COST_LIMIT=100
ESTIMATED_COST_PER_INTERACTION=2.00

# Application Settings
IDLE_VIDEO_URL=https://your-cdn.com/idle-avatar-loop.mp4
RESPONSE_TIMEOUT=60000

# UI Feedback Messages
PROCESSING_MESSAGE="Processing your request... (this takes about 45 seconds)"
COST_WARNING_MESSAGE="Approaching daily usage limit"

# Real-time Interactive Avatar API (Streaming)
HEYGEN_ACCESS_TOKEN=your-heygen-access-token-here
HEYGEN_AVATAR_ID=Alessandra_ProfessionalLook2_public
HEYGEN_KNOWLEDGE_ID=your-knowledge-base-id-optional
INTERACTIVE_SESSION_TIMEOUT=120000
STATIC_AVATAR_IMAGE=assets/fallback/avatar-poster.jpg