    "@tm/tailwind-config": "workspace:*",
    "@tm/tsconfig": "workspace:*"
  },
  "dependencies": {
    "pino": "^9.6.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@tm/eslint-config/base",
