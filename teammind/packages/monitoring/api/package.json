{
  "name": "@tm/monitoring",
  "private": true,
  "sideEffects": false,
  "version": "0.1.0",
  "scripts": {
    "clean": "git clean -xdf ../.turbo node_modules",
    "format": "prettier --check \"**/*.{ts,tsx}\"",
    "lint": "eslint ..",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@tm/prettier-config",
  "exports": {
    "./server": "./src/server.ts",
    "./instrumentation": "./src/instrumentation.ts",
    "./hooks": "./src/hooks/index.ts",
    "./components": "./src/components/index.ts"
  },
  "devDependencies": {
    "@tm/eslint-config": "workspace:*",
    "@tm/monitoring-core": "workspace:*",
    "@tm/prettier-config": "workspace:*",
    "@tm/sentry": "workspace:*",
    "@tm/tailwind-config": "workspace:*",
    "@tm/tsconfig": "workspace:*",
    "@types/react": "^19.0.10",
    "react": "19.0.0"
  },
  "eslintConfig": {
    "root": true,
    "extends": [
      "@tm/eslint-config/base",
      "@tm/eslint-config/react"
    ]
  },
  "typesVersions": {
    "*": {
      "*": [
        "src/*"
      ]
    }
  }
}
