    "@tm/team-accounts": "workspace:^",
    "@tm/ui": "workspace:^",
    "@trigger.dev/sdk": "3.3.17",
    "@types/localtunnel": "^2.0.4",
    "ai": "^4.3.9",
    "date-fns": "^4.1.0",
    "exa-js": "^1.6.13",
    "framer-motion": "^12.9.2",
    "googleapis": "^148.0.0",
